# File: .editorconfig
# Purpose: Share whitespace and encoding conventions across project editors.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
