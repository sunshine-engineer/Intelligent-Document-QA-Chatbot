# File: .env.sample
# Purpose: Document nonsecret application, provider, logging and local Compose defaults.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23

#####################################
# Ollama Configuration
#####################################

# Native runs: use http://localhost:11434. Compose overrides this value.
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=1m
EMBEDDING_MODEL=nomic-embed-text:latest
LLM_MODEL=openai/gpt-oss-20b
PDF_DIRECTORY=research_papers
# Native default; Compose overrides this to /app/faiss-data/index.
INDEX_DIRECTORY=faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=4
MAX_TOP_K=10
RETRIEVAL_RELEVANCE_THRESHOLD=0.35

#####################################
# API Keys Configuration
#####################################

GROQ_API_KEY=

# Optional Compose ports/profile settings and CI configuration:
# See docs/configuration.md. Shell examples in docs assume Bash/WSL.

#####################################
# Provider limits (defaults preserve existing behavior)
#####################################
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024
EMBEDDING_TIMEOUT_SECONDS=60

#####################################
# UI/context limits (characters except message count)
#####################################
MAX_QUESTION_CHARACTERS=4000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARACTERS=6000
MAX_CONTEXT_CHARACTERS=16000

#####################################
# Application log retention
#####################################
LOG_DIRECTORY=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Optional host ports; uncomment only when changing the defaults.
# STREAMLIT_PORT=8501
# POSTGRES_PORT=5432
# POSTGRES_DB=chatbot
# POSTGRES_USER=chatbot
# POSTGRES_PASSWORD=replace-with-your-own-local-value
# Optional live-smoke script setting; the script does not load .env itself.
# SMOKE_TIMEOUT_SECONDS=20
